# ---- Artefactos pesados que no deben versionarse ----
# 2 MB de base64: quedó sin uso al pasar a servidor local (se puede borrar).
assets-inline.js

# Renders de vista previa (se regeneran exportando desde el editor)
Vista previa*.png
*.export.png
salida/

# Originales del usuario: ya están copiados en assets/
WOLF IT/

# ---- Proyectos locales ----
# Los .flyer.json de trabajo son personales; versioná solo los que quieras
# compartir como plantilla, con: git add -f plantillas/loquesea.flyer.json
*.flyer.json
!plantillas/*.flyer.json

# ---- Claves y secretos: NUNCA versionar ----
# Este es un repo público. Las API keys viven en el navegador de cada usuario
# (ver README, sección "API keys"), jamás en el código.
.env
.env.*
config.local.js
config.local.json
secretos/
*.key
*.pem
credentials.json

# ---- Sistema ----
Thumbs.db
desktop.ini
.DS_Store
*.tmp
.vscode/
.idea/
