# Normaliza los finales de línea: LF en el repo, nativo en el working copy.
* text=auto eol=lf

# El .bat tiene que quedar con CRLF para que Windows lo ejecute bien.
*.bat text eol=crlf

# Binarios: que git no intente convertir nada.
*.png binary
*.webp binary
*.jpg binary
*.woff2 binary

# El bundle de Konva es código vendorizado: no cuenta en las estadísticas
# del repo ni ensucia los diffs.
vendor/** linguist-vendored
